#!/usr/bin/env sh

if [[ $1 = "random-wallpaper" ]]; then
	wallpaper=$(find ~/Pictures/wallpapers -not -name "*.sh" -and -not -name "\.*" -type f | shuf -n1)
	[[ -z $wallpaper ]] && exit 1
	hyprctl hyprpaper wallpaper ,$wallpaper
fi

if [[ $1 = "choose-wallpaper" ]]; then
	wallpaper=$(find ~/Pictures/wallpapers -not -name "*.sh" -and -not -name "\.*" -type f -printf "%f\n" | fuzzel --dmenu)
	[[ -z $wallpaper ]] && exit 1
	wallpaper=~/Pictures/wallpapers/$wallpaper
	hyprctl hyprpaper wallpaper ,$wallpaper
fi

if [[ $1 = "pick-emoji" ]]; then
	if [[ $2 = "generate" ]]; then
		curl -s https://raw.githubusercontent.com/muan/emojilib/refs/heads/main/dist/emoji-en-US.json \
			| jq 'to_entries | map("\(.key) \(.value | join(", "))")[]' -r > ~/scripts/emoji-picker-data
		exit 0
	fi

	address=$(hyprctl activewindow -j | jq .address -r)
	line=$(fuzzel --dmenu <~/scripts/emoji-picker-data)
	[[ -z $line ]] && exit 1
	hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })"
	sleep 0.1
	wtype "$(echo $line | cut -d' ' -f1)"
	exit 0
fi

if [[ $1 = "find-window" ]]; then
	window=$(hyprctl clients -j | jq -r '.[] | "\(.address): \(.title)"' | fuzzel -d)
	[[ -z "$window" ]] && exit 1
	address=$(echo "$window" | sed 's/\(.*\): .*/\1/')
	hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })"
fi
